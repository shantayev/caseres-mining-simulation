[core]
	repositoryformatversion = 0
	filemode = true
	bare = false
	logallrefupdates = true
	ignorecase = true
	precomposeunicode = true
[remote "origin"]
	url = https://github.com/shantayev/caseres-mining-simulation
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[branch "new-mining-logic"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/new-mining-logic
[branch "version_v5"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/version_v5
[branch "feature/min-required-mitigation"]
	vscode-merge-base = origin/version_v5
[branch "feature/air-quality"]
	vscode-merge-base = origin/version_v5
[branch "feature/slider-v2"]
	vscode-merge-base = origin/version_v5
[branch "joint"]
	remote = origin
	merge = refs/heads/joint
	vscode-merge-base = origin/main
[branch "map"]
	vscode-merge-base = origin/joint
	remote = origin
	merge = refs/heads/map
[branch "fix/regional-map-grammar"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/fix/regional-map-grammar
